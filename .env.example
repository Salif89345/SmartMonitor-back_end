# Mode d'execution
APP_ENV=dev
LOG_LEVEL=DEBUG

# PostgreSQL - remplacer localement, ne jamais committer .env
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smartmonitor
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=smartmonitor-backend-v1
MQTT_KEEPALIVE=30
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_PATH=certs/ca.pem
MQTT_DEPLOYMENT_ENV=dev
MQTT_ALLOWED_PROD_HOSTS=
MQTT_CREDENTIAL_ID=dev-local

# Autorisation des commandes appareil
COMMAND_AUTH_KEYS_PATH=.secrets/command_authorization_keys.json

# API et authentification
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_SECRET=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=CHANGE_ME
API_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Ingestion
POWER_HISTORY_INTERVAL_SECONDS=60
MQTT_INGESTION_QUEUE_SIZE=500
