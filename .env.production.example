# Exemple uniquement. Ne jamais committer le fichier de production reel.
APP_ENV=prod
LOG_LEVEL=INFO

# PostgreSQL de production
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=smartmonitor
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Broker MQTT de production dedie
MQTT_HOST=prod-broker.example.invalid
MQTT_PORT=8883
MQTT_USERNAME=smartmonitor-backend-prod
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=smartmonitor-backend-prod-primary
MQTT_KEEPALIVE=30
MQTT_TLS_ENABLED=true
MQTT_CA_CERT_PATH=certs/production-ca.crt
MQTT_DEPLOYMENT_ENV=prod
MQTT_ALLOWED_PROD_HOSTS=prod-broker.example.invalid
MQTT_CREDENTIAL_ID=prod-YYYY-MM-a

# Autorisation des commandes appareil
COMMAND_AUTH_KEYS_PATH=.secrets/command_authorization_keys.json

# API et authentification
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_SECRET=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=CHANGE_ME
API_ALLOWED_HOSTS=api.smartmonitor.example
CORS_ALLOWED_ORIGINS=https://app.smartmonitor.example

# Ingestion
POWER_HISTORY_INTERVAL_SECONDS=60
MQTT_INGESTION_QUEUE_SIZE=500
